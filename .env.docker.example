# Copy this file to .env before running `docker compose up --build`.
# The passwords below are required; ADMIN_NAME and APP_PORT fall back to
# defaults. The app ships with no demo data or demo logins, so ADMIN_PASSWORD
# is the only way in on a fresh install.

# Password for the PostgreSQL application database account
DB_PASSWORD=replace_with_another_long_random_password

# First administrator account, created automatically on first API start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_different_password_at_least_12_chars
ADMIN_NAME=Administrator

# Host port the web interface is published on
APP_PORT=8080
