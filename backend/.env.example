PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace_me
PGDATABASE=hamro_lunch_box

# First administrator created on startup when no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_password_with_at_least_12_characters
ADMIN_NAME=Administrator

# Set to true only when the API is served over HTTPS.
COOKIE_SECURE=false
